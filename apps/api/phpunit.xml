<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:XBR7jpZ5MSnZU0etGYTaKDYfQ/xtnZPMO5EouIFaY5I="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Schema relies on Postgres-only features (gen_random_uuid(), text[]
             columns, GIN full-text index), so tests run against a real Postgres
             database rather than sqlite. Set explicitly (not just DB_DATABASE)
             so a missing/misconfigured .env can't silently fall back to the
             config default of sqlite. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="healthsync_test"/>
        <env name="DB_USERNAME" value="healthsync"/>
        <env name="DB_PASSWORD" value="healthsync"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="AWS_ACCESS_KEY_ID" value="test-key"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="test-secret"/>
        <env name="AWS_DEFAULT_REGION" value="ap-south-1"/>
        <env name="AWS_BUCKET" value="healthsync-test"/>
        <env name="JWT_SECRET" value="test-jwt-secret-do-not-use-in-production"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
